<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps NuGet inside the repo: only nuget.org, packages cached in .tools/nuget (not ~/.nuget). -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".tools/nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
