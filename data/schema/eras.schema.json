{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EraFile",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_]*:)?[a-z][a-z0-9_]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "minPopulation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "maxPopulation": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1000000
          },
          "territoryRadius": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "required": [
          "id",
          "order",
          "minPopulation",
          "maxPopulation",
          "territoryRadius"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
