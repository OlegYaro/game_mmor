{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimeBalanceFile",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_]*:)?[a-z][a-z0-9_]*$"
          },
          "ticksPerSecond": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "realMinutesPerGameDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "nightPermille": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "daysPerWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "daysPerSeason": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "seasonsPerYear": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "ticksPerSecond",
          "realMinutesPerGameDay",
          "nightPermille",
          "daysPerWeek",
          "daysPerSeason",
          "seasonsPerYear"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
