{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfessionFile",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_]*:)?[a-z][a-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "pattern": "^(ordinary|specialist)$",
            "description": "ordinary or specialist. The specialist list (blacksmith, healer, armorer) is proposal A7, not yet confirmed by the owner."
          },
          "skill": {
            "type": "string",
            "pattern": "^(construction|mining|farming|hunting|cooking|crafting|smithing|medicine|trading|knowledge|melee|shooting)$"
          },
          "jobTypes": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": "Job types this profession takes: haul, chop, plant, quarry, forage or farm. No repeats; may be empty."
          }
        },
        "required": [
          "id",
          "kind",
          "skill",
          "jobTypes"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
